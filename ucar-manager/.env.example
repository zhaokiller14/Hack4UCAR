# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# WARNING: never commit this secret
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# n8n extraction webhook (production URL — no -test suffix)
N8N_DATA_INGEST_WEBHOOK_URL=https://<your-n8n-instance>/webhook/data-ingest
# Signed URL TTL in seconds sent to n8n for fetching uploaded files
N8N_SIGNED_URL_TTL_SECONDS=3600

# Supabase Storage bucket (used by /api/uploads/raw)
S3_BUCKET=documents
S3_KEY_PREFIX=raw-uploads

NEXT_PUBLIC_RAG_API_URL=https://<your-n8n-instance>/webhook/rag
