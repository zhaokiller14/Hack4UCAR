# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service Role Key (found in Supabase Dashboard > Settings > API > Service Role Secret)
# WARNING: This is a secret key, never commit to version control!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n extraction webhook
N8N_DATA_INGEST_WEBHOOK_URL=
# Signed URL TTL (seconds) sent to n8n for fetching uploaded files
N8N_SIGNED_URL_TTL_SECONDS=3600

# Supabase Storage bucket configuration (used by /api/uploads/raw)
S3_BUCKET=your-bucket-name
S3_KEY_PREFIX=raw-uploads
